# Copy to .env for local use. Never commit real values.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# demo, esphome, push, or tuya. Tuya mode uses the local LAN only.
SOURCE=demo
POLL_SECONDS=60
STALE_SECONDS=180

# ESPHome local web API, after compatible firmware is installed and sensor names verified.
LOCAL_BASE_URL=
LOCAL_TEMPERATURE_PATH=
LOCAL_HUMIDITY_PATH=
LOCAL_USERNAME=
LOCAL_PASSWORD=

# Existing Tuya device over its local LAN (protocol 3.4 verified for this sensor).
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_DEVICE_IP=
TUYA_PROTOCOL_VERSION=3.4
# Start with true to inspect DP values. After mapping, set false and fill IDs/scales.
TUYA_DISCOVER_DPS=true
TUYA_TEMPERATURE_DP=
TUYA_HUMIDITY_DP=
TUYA_TEMPERATURE_SCALE=10
TUYA_HUMIDITY_SCALE=10

# Push mode: a local bridge POSTs JSON to /api/ingest with this bearer token.
INGEST_TOKEN=

# Required if binding beyond localhost. Also recommended for local use.
APP_PASSWORD=
